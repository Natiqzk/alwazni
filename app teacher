        مدير_الشاشات = ScreenManager()

        مدير_الشاشات.add_widget(
            شاشة_القائمة(name="القائمة")
        )

        مدير_الشاشات.add_widget(
            شاشة_التحرير(name="التحرير")
        )

        return مدير_الشاشات


